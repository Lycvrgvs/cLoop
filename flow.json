{
  "version": "1.2.0",
  "start": { "new": "DEFINE", "existing": "ADOPT" },
  "escape": "ASK",
  "states": {
    "ADOPT": { "next": ["DEFINE", "EXPLORE", "ONESHOT", "LOOP"], "exit": ["baselineRun", "adoptRecord", "adoptRubric"], "to": { "EXPLORE": ["exploreTrigger"] } },
    "DEFINE": { "next": ["EXPLORE", "ONESHOT", "LOOP", "DUEL", "GATE"], "exit": ["rubricValid", "rubricFrozen", "redefineBuilds"], "to": { "GATE": ["stageEstablished"], "EXPLORE": ["exploreTrigger"] } },
    "EXPLORE": { "next": ["LOOP", "GATE", "DUEL", "ASK"], "exit": ["rubricUnchanged", "exploreSettled", "passRoute"], "to": { "GATE": ["stageEstablished"] } },
    "ONESHOT": { "next": ["LOOP", "GATE", "DUEL", "ASK"], "exit": ["rubricUnchanged", "realRun", "judged", "passRoute"], "to": { "GATE": ["stageEstablished"] } },
    "LOOP": { "next": ["LOOP", "GATE", "DUEL", "ASK"], "exit": ["rubricUnchanged", "seenFailing", "judged", "passRoute"], "to": { "GATE": ["stageEstablished"] } },
    "DUEL": { "next": ["LOOP", "GATE", "DUEL", "ASK"], "exit": ["rubricUnchanged", "judged", "passRoute"], "to": { "GATE": ["stageEstablished"] } },
    "GATE": { "next": ["ONESHOT", "LOOP", "DUEL", "ACCEPT", "ASK"], "exit": ["rubricUnchanged", "judged", "passRoute"] },
    "ASK": { "next": ["DEFINE", "EXPLORE", "STOPPED"], "exit": ["userAnswer"], "to": { "DEFINE": ["replanApproved"], "EXPLORE": ["replanApproved"] } },
    "ACCEPT": { "next": ["DONE", "DEFINE", "EXPLORE"], "to": { "DONE": ["finalReport", "proposalsResolved", "gatedHead"], "DEFINE": ["userAnswer"], "EXPLORE": ["userAnswer"] } },
    "DONE": { "next": [], "terminal": true },
    "STOPPED": { "next": [], "terminal": true }
  },
  "always": ["ladder"],
  "commands": {
    "adopt": ["ADOPT"],
    "freeze": ["ADOPT", "DEFINE"],
    "call member": ["DEFINE"],
    "call explorer": ["EXPLORE"],
    "call judge": ["EXPLORE", "ONESHOT", "LOOP", "DUEL", "GATE"],
    "call dueler": ["DUEL", "ASK"],
    "call dynamic": ["ONESHOT", "LOOP"],
    "call mechanical": ["ONESHOT", "LOOP"],
    "stepback small": ["EXPLORE", "ONESHOT", "LOOP"],
    "stepback replan": ["ASK"],
    "run --before": ["LOOP"],
    "run --e2e": ["GATE"],
    "run --suite": ["GATE"],
    "judge explore": ["EXPLORE"],
    "judge oneshot": ["ONESHOT"],
    "judge loop": ["LOOP"],
    "judge merge": ["EXPLORE", "DUEL"],
    "judge gate": ["GATE"],
    "winner": ["EXPLORE"],
    "reproduce": ["EXPLORE", "ONESHOT", "LOOP", "DUEL", "GATE"],
    "redispatch": ["DEFINE", "EXPLORE", "ONESHOT", "LOOP", "DUEL", "GATE", "ASK"],
    "blocked": ["DEFINE", "EXPLORE", "ONESHOT", "LOOP", "DUEL", "GATE"],
    "answer": ["ASK", "ACCEPT"],
    "approve": ["ASK"],
    "report --final": ["ACCEPT"],
    "clean": ["DONE", "STOPPED"]
  },
  "rungs": {
    "small": { "state": "LOOP", "says": "your small step back (PREVENT), then a small loop" },
    "full": { "state": "DUEL", "says": "two loop-breakers' full step backs, each with a small loop; one merge, one council" },
    "redefine": { "state": "ASK", "says": "a re-define: the user, then the loop-breakers' re-plan, approved by the user" }
  },
  "ladder": {
    "small": { "ADVANCED": [3, "full"], "STALLED": [2, "full"], "REGRESSION": [2, "full"] },
    "full": { "ADVANCED": [1, "small"], "STALLED": [2, "redefine"], "REGRESSION": [2, "redefine"] },
    "redefine": { "ADVANCED": [1, "small"], "STALLED": [1, "redefine"], "REGRESSION": [1, "redefine"] },
    "pass": "small",
    "blocked": "redefine",
    "oneshot": { "good": "LOOP", "bad": "ASK" }
  },
  "cards": [
    { "card": "adopt", "state": "ADOPT", "role": "root" },
    { "card": "define", "state": "DEFINE", "role": "root" },
    { "card": "merge", "state": "DEFINE", "role": "root" },
    { "card": "member", "state": "DEFINE", "role": "member" },
    { "card": "explore", "state": "EXPLORE", "role": "root" },
    { "card": "step-back", "state": "EXPLORE", "role": "root" },
    { "card": "merge", "state": "EXPLORE", "role": "root" },
    { "card": "explorer", "state": "EXPLORE", "role": "explorer" },
    { "card": "judge", "state": "EXPLORE", "role": "judge" },
    { "card": "oneshot", "state": "ONESHOT", "role": "root" },
    { "card": "step-back", "state": "ONESHOT", "role": "root" },
    { "card": "judge", "state": "ONESHOT", "role": "judge" },
    { "card": "dynamic", "state": "ONESHOT", "role": "dynamic" },
    { "card": "mechanical", "state": "ONESHOT", "role": "mechanical" },
    { "card": "loop", "state": "LOOP", "rung": "small", "role": "root" },
    { "card": "step-back", "state": "LOOP", "role": "root" },
    { "card": "judge", "state": "LOOP", "role": "judge" },
    { "card": "dynamic", "state": "LOOP", "role": "dynamic" },
    { "card": "mechanical", "state": "LOOP", "role": "mechanical" },
    { "card": "duel", "state": "DUEL", "rung": "full", "role": "root" },
    { "card": "step-back", "state": "DUEL", "role": "root" },
    { "card": "merge", "state": "DUEL", "role": "root" },
    { "card": "dueler", "state": "DUEL", "role": "dueler" },
    { "card": "judge", "state": "DUEL", "role": "judge" },
    { "card": "gate", "state": "GATE", "role": "root" },
    { "card": "judge", "state": "GATE", "role": "judge" },
    { "card": "ask", "state": "ASK", "rung": "redefine", "role": "root" },
    { "card": "step-back", "state": "ASK", "role": "root" },
    { "card": "merge", "state": "ASK", "role": "root" },
    { "card": "dueler", "state": "ASK", "role": "dueler" },
    { "card": "accept", "state": "ACCEPT", "role": "root" },
    { "card": "done", "state": "DONE", "role": "root" },
    { "card": "stopped", "state": "STOPPED", "role": "root" }
  ]
}
